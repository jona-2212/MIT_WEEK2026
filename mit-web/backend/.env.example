# Konfigurasi lokal; salin ke .env jika belum tersedia.
APP_NAME=Job Scam Guardian AI
APP_ENV=development
DEBUG=false
LOG_LEVEL=INFO
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Recognition memakai Gemini saat analisis; key tidak wajib untuk startup/health.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT_SECONDS=45
# Fase A: JSON read-only pada runtime. Path relatif root layanan.
UPLOAD_PROFILE=local
LEGAL_INDEX_PATH=data/legal_index
LEGAL_REGISTRY_PATH=data/knowledge/sources.json
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_TIMEOUT_SECONDS=15
LEGAL_TOP_K=3
# Parameter eksperimen; similarity bukan bukti pelanggaran.
LEGAL_MIN_SIMILARITY=0.75
# Voice belum diimplementasikan.
ELEVENLABS_API_KEY=
